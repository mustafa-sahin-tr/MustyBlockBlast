  - m_Id: 1357482424262668
    m_Localized: Puntos dobles
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262669
    m_Localized: Duplica los puntos un rato
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262670
    m_Localized: Ajuste fantasma
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262671
    m_Localized: "Se\xF1ala la mejor jugada"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178001227776
    m_Localized: Primeros pasos
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587904
    m_Localized: "Cortal\xEDneas"
    m_Metadata:
