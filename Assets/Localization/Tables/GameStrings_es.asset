    m_Metadata:
      m_Items: []
  - m_Id: 3514168870166532
    m_Localized: Cruz de pintura
    m_Metadata:
      m_Items: []
  - m_Id: 3514168870166533
    m_Localized: Recolorea toda la fila y columna de una celda
    m_Metadata:
      m_Items: []
  - m_Id: 3514168870166534
    m_Localized: Cruz de pintura
    m_Metadata:
      m_Items: []
  - m_Id: 3514168870166535
    m_Localized: 'Toca una celda y elige un color: su fila y su columna se pintan de ese color. No se borra nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 3514168870166536
    m_Localized: Elige un color
    m_Metadata:
      m_Items: []
  - m_Id: 3514168870166537
    m_Localized: Pintar
    m_Metadata:
      m_Items: []
  - m_Id: 3631194057990144
    m_Localized: "Llena una celda de hielo y desp\xE9jala; cada despeje derrite una capa."
