    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984190
    m_Localized: No se pudieron sembrar las monedas. Tus cargas siguen guardadas.
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984191
    m_Localized: Este nivel no se puede empezar ahora.
    m_Metadata:
      m_Items: []
