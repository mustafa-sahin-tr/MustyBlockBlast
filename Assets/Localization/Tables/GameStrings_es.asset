    m_Localized: "Anotador de \xE9lite"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587925
    m_Localized: Despeja bloques de este color {0}; cada uno destruido cuenta.
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587926
    m_Localized: Solo en modo contrarreloj
    m_Metadata:
      m_Items: []
