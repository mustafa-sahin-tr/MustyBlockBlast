      m_Items: []
  - m_Id: 781257951666179
    m_Localized: Toca un nivel desbloqueado para jugarlo
    m_Metadata:
      m_Items: []
  - m_Id: 1253490004320256
    m_Localized: Quitar anuncios
    m_Metadata:
      m_Items: []
  - m_Id: 1253490004320257
    m_Localized: "Anuncios eliminados \xB7 gracias por apoyar el juego"
