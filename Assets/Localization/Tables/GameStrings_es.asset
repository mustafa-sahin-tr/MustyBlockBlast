    m_Localized: "Oto\xF1o"
    m_Metadata:
      m_Items: []
  - m_Id: 149663784099840
    m_Localized: "Limpia exactamente {0} filas o columnas a la vez con una sola pieza. M\xE1s no cuenta."
    m_Metadata:
      m_Items: []
  - m_Id: 149663859597312
    m_Localized: "Cuentan las piezas {0} de todo tama\xF1o y giro."
    m_Metadata:
      m_Items: []
  - m_Id: 149663863791616
    m_Localized: "Alcanza la puntuaci\xF3n objetivo en una partida."
    m_Metadata:
      m_Items: []
  - m_Id: 149663863791617
    m_Localized: "Vac\xEDa todo el tablero con una sola jugada."
    m_Metadata:
      m_Items: []
  - m_Id: 149663863791618
    m_Localized: sencillas
    m_Metadata:
      m_Items: []
  - m_Id: 149663867985920
    m_Localized: "de l\xEDnea"
    m_Metadata:
      m_Items: []
  - m_Id: 149663872180224
    m_Localized: cuadradas
    m_Metadata:
      m_Items: []
  - m_Id: 149663872180225
    m_Localized: de esquina
    m_Metadata:
      m_Items: []
  - m_Id: 149663872180226
    m_Localized: en T
    m_Metadata:
      m_Items: []
  - m_Id: 149663872180227
