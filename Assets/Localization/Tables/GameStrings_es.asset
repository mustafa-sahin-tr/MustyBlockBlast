    m_Localized: "SIGUIENTE \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4289495674380288
    m_Localized: '{0} / {1} vidas'
    m_Metadata:
      m_Items: []
  - m_Id: 4289495720517632
    m_Localized: Ganar es gratis. Fallar este nivel cuesta 1 vida.
    m_Metadata:
      m_Items: []
  - m_Id: 4289495720517633
    m_Localized: SIN VIDAS
    m_Metadata:
      m_Items: []
