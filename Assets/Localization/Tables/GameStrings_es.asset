    m_Localized: COMPRAR
    m_Metadata:
      m_Items: []
  - m_Id: 2136016131401282
    m_Localized: No hay paquetes de monedas configurados.
    m_Metadata:
      m_Items: []
  - m_Id: 2136016131401346
    m_Localized: "\xA1Convertido!"
    m_Metadata:
      m_Items: []
  - m_Id: 2136016131401410
    m_Localized: "Todav\xEDa no hay nada que convertir."
    m_Metadata:
      m_Items: []
  - m_Id: 2136016131401474
    m_Localized: "\xA1Monedas a\xF1adidas!"
    m_Metadata:
      m_Items: []
  - m_Id: 2136016131401538
    m_Localized: No hay anuncios disponibles ahora.
    m_Metadata:
      m_Items: []
  - m_Id: 2136016131401602
    m_Localized: Compra no completada.
    m_Metadata:
      m_Items: []
  - m_Id: 2136016131401666
    m_Localized: "\xA1Comprado!"
    m_Metadata:
      m_Items: []
  - m_Id: 2136016131401730
    m_Localized: No tienes suficientes monedas.
    m_Metadata:
      m_Items: []
  - m_Id: 2136016131401794
    m_Localized: Sube de nivel para desbloquear esto.
    m_Metadata:
      m_Items: []
