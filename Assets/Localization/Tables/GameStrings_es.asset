    m_Localized: "Vac\xEDa una columna entera"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262660
    m_Localized: "Comod\xEDn"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262661
    m_Localized: "Rellena una celda vac\xEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262662
    m_Localized: Limpiador de color
    m_Metadata:
