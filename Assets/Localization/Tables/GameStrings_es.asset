    m_Metadata:
      m_Items: []
  - m_Id: 1720781938614279
    m_Localized: INSIGNIAS DE ESTA PARTIDA
    m_Metadata:
      m_Items: []
  - m_Id: 1720781942808576
    m_Localized: "TOCA \xB7 GANA MONEDAS"
    m_Metadata:
      m_Items: []
  - m_Id: 1720781942808577
    m_Localized: VOLVER A JUGAR
    m_Metadata:
      m_Items: []
  - m_Id: 1720781942808578
    m_Localized: CAMBIAR MODO
    m_Metadata:
      m_Items: []
