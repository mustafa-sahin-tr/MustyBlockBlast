  - m_Id: 209334783959040
    m_Localized: "Bir kombo serisine ula\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 217997032546304
    m_Localized: "Bombayla bir s\u0131ray\u0131 bo\u015Falt"
    m_Metadata:
      m_Items: []
  - m_Id: 225277056638976
    m_Localized: "Ayn\u0131 anda bir s\u0131ra ve bir s\xFCtun temizle"
    m_Metadata:
      m_Items: []
  - m_Id: 227150882922496
    m_Localized: "Bask\u0131 alt\u0131nda bir s\u0131ra temizle"
    m_Metadata:
      m_Items: []
  - m_Id: 228634777346048
    m_Localized: "Ayn\u0131 anda {0}+ s\u0131ra temizle"
    m_Metadata:
      m_Items: []
  - m_Id: 230162711961600
    m_Localized: "Bir {0} par\xE7a yerle\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 230162825207808
    m_Localized: "Bir {0} par\xE7a ile s\u0131ra temizle"
    m_Metadata:
      m_Items: []
  - m_Id: 234786474942464
    m_Localized: 3x3 blok
    m_Metadata:
      m_Items: []
  - m_Id: 234786563022848
    m_Localized: "5'li \xE7izgi"
    m_Metadata:
      m_Items: []
  - m_Id: 236115477913600
    m_Localized: "Bir k\xF6\u015Feden ge\xE7en s\u0131ra temizle"
    m_Metadata:
      m_Items: []
  - m_Id: 236115591159808
    m_Localized: "Tahtan\u0131n merkezini bo\u015Falt"
    m_Metadata:
      m_Items: []
  - m_Id: 236115591159809
    m_Localized: "Tahtay\u0131 s\u0131k\u0131\u015Fm\u0131\u015F bo\u015Fluklardan uzak tut"
    m_Metadata:
      m_Items: []
  - m_Id: 240837526020096
    m_Localized: "{0} saniye i\xE7inde s\u0131ra temizle"
    m_Metadata:
      m_Items: []
  - m_Id: 240837534408704
    m_Localized: "\u0130lk {0} saniye i\xE7inde hedef skora ula\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 280945016954880
    m_Localized: "Elindeki hamle bitmi\u015Fken ama cebindeki par\xE7a seni kurtar\u0131rken Yeniden \xC7ekil kullan"
    m_Metadata:
      m_Items: []
  - m_Id: 288624816939008
    m_Localized: 2 kat {0}
    m_Metadata:
      m_Items: []
  - m_Id: 288624816939009
    m_Localized: "Yerle\u015Ftirilebilecek yer yok"
    m_Metadata:
      m_Items: []
  - m_Id: 781257783894016
    m_Localized: "B\xF6l\xFCm {0} Tamamland\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 781257951666177
    m_Localized: Yol
    m_Metadata:
      m_Items: []
  - m_Id: 781257951666178
    m_Localized: "Yol toplam\u0131: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 781257951666179
    m_Localized: "Oynamak i\xE7in a\xE7\u0131lm\u0131\u015F bir b\xF6l\xFCme dokun"
    m_Metadata:
      m_Items: []
  - m_Id: 1253490004320256
    m_Localized: "Reklamlar\u0131 kald\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 1253490004320257
    m_Localized: "Reklamlar kald\u0131r\u0131ld\u0131 \xB7 deste\u011Fin i\xE7in te\u015Fekk\xFCrler"
    m_Metadata:
      m_Items: []
  - m_Id: 1292508796542976
    m_Localized: Sakla
    m_Metadata:
      m_Items: []
  - m_Id: 1355798369263616
    m_Localized: "Power-up Ma\u011Fazas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1355798423789568
    m_Localized: "S\u0131ralama"
    m_Metadata:
      m_Items: []
  - m_Id: 1355798423789569
    m_Localized: Profil
    m_Metadata:
      m_Items: []
  - m_Id: 1355798423789570
    m_Localized: Rozetler
    m_Metadata:
      m_Items: []
  - m_Id: 1357482390708224
    m_Localized: Bomba
    m_Metadata:
      m_Items: []
  - m_Id: 1357482415874048
    m_Localized: "Bir h\xFCcrenin \xE7evresindeki 3x3 alan\u0131 temizler"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262656
    m_Localized: "Sat\u0131r Temizle"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262657
    m_Localized: "Bir sat\u0131r\u0131 tamamen bo\u015Falt\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262658
    m_Localized: "S\xFCtun Temizle"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262659
    m_Localized: "Bir s\xFCtunu tamamen bo\u015Falt\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262660
    m_Localized: Joker
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262661
    m_Localized: "Bo\u015F bir h\xFCcreyi doldurur"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262662
    m_Localized: Renk Temizleyici
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262663
    m_Localized: "Bir rengin t\xFCm h\xFCcrelerini temizler"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262664
    m_Localized: "D\xF6nd\xFCr"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262665
    m_Localized: "Bir par\xE7ay\u0131 90\xB0 d\xF6nd\xFCr\xFCr"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262666
    m_Localized: "Yeniden Da\u011F\u0131t"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262667
    m_Localized: "\xDC\xE7 yeni par\xE7a da\u011F\u0131t\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262668
    m_Localized: "\xC7ift Puan"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262669
    m_Localized: "Bir s\xFCre t\xFCm puanlar\u0131 ikiye katlar"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262670
    m_Localized: "Hayalet Yerle\u015Fim"
    m_Metadata:
      m_Items: []
  - m_Id: 1357482424262671
    m_Localized: "En iyi hamleyi g\xF6sterir"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178001227776
    m_Localized: "\u0130lk Ad\u0131mlar"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587904
    m_Localized: "\xC7izgi Kesici"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587905
    m_Localized: "Tahta S\xFCp\xFCr\xFCc\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587906
    m_Localized: "Y\xFCksek Skorcu"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587907
    m_Localized: "Y\xFCzler Kul\xFCb\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587908
    m_Localized: "M\xFCkemmeliyet\xE7i"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587909
    m_Localized: "K\u0131demli"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587910
    m_Localized: "G\xFC\xE7 Oyuncusu"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587911
    m_Localized: Maraton
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587912
    m_Localized: Elit Skorcu
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587925
    m_Localized: "{0} bloklar\u0131 temizle"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587926
    m_Localized: "Yaln\u0131zca s\xFCreli modda"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587927
    m_Localized: "A\xE7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587928
    m_Localized: "Kapal\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587929
    m_Localized: "Reklamlar \xB7 tek seferlik sat\u0131n alma"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587930
    m_Localized: "Her \u015Feyi yeniden boyar"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587931
    m_Localized: "Oynan\u0131yor"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587932
    m_Localized: "{0} moduna ge\xE7ilsin mi?"
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587933
    m_Localized: "Tahta dolana kadar oyna. En iyi skorunun pe\u015Fine d\xFC\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587934
    m_Localized: "S\xFCre dolmadan olabildi\u011Fince puan topla."
    m_Metadata:
      m_Items: []
  - m_Id: 1371178030587935
    m_Localized: Yol boyunca her seviyede bir hedefi tamamla.
    m_Metadata:
      m_Items: []
  - m_Id: 1665464840216576
    m_Localized: PUAN
    m_Metadata:
      m_Items: []
  - m_Id: 1665464869576704
    m_Localized: "x{0} SER\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 1665464869576705
    m_Localized: HEDEF
    m_Metadata:
      m_Items: []
  - m_Id: 1665464869576706
    m_Localized: SV
    m_Metadata:
      m_Items: []
  - m_Id: 1665464869576708
    m_Localized: "SEV\u0130YE {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1673053435060224
    m_Localized: CEP
    m_Metadata:
      m_Items: []
  - m_Id: 1720781875699712
    m_Localized: "Tepsideki par\xE7alar tahtaya s\u0131\u011Fm\u0131yor"
    m_Metadata:
      m_Items: []
  - m_Id: 1720781938614272
    m_Localized: "{0} s\xFCreli tur bitti"
    m_Metadata:
      m_Items: []
  - m_Id: 1720781938614273
    m_Localized: "T\xFCm hedefler tamamland\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1720781938614274
    m_Localized: "Seviye {0} hen\xFCz ge\xE7ilmedi"
    m_Metadata:
      m_Items: []
  - m_Id: 1720781938614275
    m_Localized: TOPLAM PUAN
    m_Metadata:
      m_Items: []
  - m_Id: 1720781938614276
    m_Localized: "SEV\u0130YE PUANI"
    m_Metadata:
      m_Items: []
  - m_Id: 1720781938614277
    m_Localized: PATH TOPLAMI
    m_Metadata:
      m_Items: []
  - m_Id: 1720781938614278
    m_Localized: "YEN\u0130!"
    m_Metadata:
      m_Items: []
  - m_Id: 1720781938614279
    m_Localized: "BU KO\u015EUDA A\xC7ILAN ROZETLER"
    m_Metadata:
      m_Items: []
  - m_Id: 1720781942808576
    m_Localized: "DOKUN \xB7 COIN AL"
    m_Metadata:
      m_Items: []
  - m_Id: 1720781942808577
    m_Localized: TEKRAR OYNA
    m_Metadata:
      m_Items: []
  - m_Id: 1720781942808578
    m_Localized: "MODU DE\u011E\u0130\u015ET\u0130R"
    m_Metadata:
      m_Items: []
  - m_Id: 1720781942808579
    m_Localized: "SONRAK\u0130 SEV\u0130YE \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1720781947002880
    m_Localized: TEKRAR DENE
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300676
    m_Localized: "Se\xE7ti\u011Fin s\xFCtundaki t\xFCm bloklar\u0131, s\xFCtun dolu olsun ya da olmas\u0131n an\u0131nda temizler. \u0130konuna dokunup silahland\u0131ktan sonra tahtada temizlemek istedi\u011Fin s\xFCtuna dokun."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300675
    m_Localized: "S\xFCtun Temizleyici"
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300674
    m_Localized: "Se\xE7ti\u011Fin sat\u0131rdaki t\xFCm bloklar\u0131, sat\u0131r dolu olsun ya da olmas\u0131n an\u0131nda temizler. \u0130konuna dokunup silahland\u0131ktan sonra tahtada temizlemek istedi\u011Fin sat\u0131ra dokun."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300673
    m_Localized: "Sat\u0131r Temizleyici"
    m_Metadata:
      m_Items: []
  - m_Id: 1869058130567171
    m_Localized: Sakla cebi
    m_Metadata:
      m_Items: []
  - m_Id: 1869058130567172
    m_Localized: "Tepsindeki bir par\xE7ay\u0131 \u015Fu an yerle\u015Ftirmek istemiyorsan, onu buraya s\xFCr\xFCkleyip bekletebilirsin. Daha sonra, ihtiyac\u0131n oldu\u011Funda buradan al\u0131p tahtaya yerle\u015Ftirebilirsin \u2014 cepte ayn\u0131 anda sadece bir par\xE7a durabilir."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300672
    m_Localized: "Tahtada se\xE7ti\u011Fin h\xFCcrenin etraf\u0131ndaki 3x3'l\xFCk alan i\xE7indeki t\xFCm bloklar\u0131 an\u0131nda yok eder. Kullanmak i\xE7in ikonuna dokun, sonra tahtada patlatmak istedi\u011Fin noktaya dokun."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479841329152
    m_Localized: Bomba
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300677
    m_Localized: Joker
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300678
    m_Localized: "Herhangi bir rengi tamamlayabilen \xF6zel bir tekli blok verir. Bu blo\u011Fu yerle\u015Ftirdi\u011Finde, tamamlad\u0131\u011F\u0131 her sat\u0131r veya s\xFCtun an\u0131nda temizlenir \u2014 normal bir par\xE7a gibi elinle s\xFCr\xFCkleyip yerle\u015Ftir."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300679
    m_Localized: Renk Temizleyici
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300680
    m_Localized: "Tahtada o an bulunan renklerden birini se\xE7mene izin verir; se\xE7ti\u011Fin renkteki t\xFCm bloklar, tahtan\u0131n neresinde olurlarsa olsunlar an\u0131nda yok olur."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300681
    m_Localized: "D\xF6nd\xFCr"
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300682
    m_Localized: "Tepsindeki par\xE7alardan birini se\xE7; yerle\u015Ftirmeden \xF6nce onu 90 derece d\xF6nd\xFCrerek tahtaya daha iyi oturmas\u0131n\u0131 sa\u011Flayabilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300683
    m_Localized: "Yeniden \xC7ek"
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300684
    m_Localized: "Elindeki hi\xE7bir par\xE7a i\u015Fine yaram\u0131yorsa, tepsideki \xFC\xE7 par\xE7an\u0131n hepsini tek seferde yeni, rastgele par\xE7alarla de\u011Fi\u015Ftirir."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300685
    m_Localized: "2x \xC7arpan"
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300686
    m_Localized: "Aktif etti\u011Finde belirli bir s\xFCre boyunca yapt\u0131\u011F\u0131n her hamleden kazand\u0131\u011F\u0131n puan ikiye katlan\u0131r \u2014 b\xFCy\xFCk bir skor ata\u011F\u0131 yapmak i\xE7in do\u011Fru an\u0131 se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300687
    m_Localized: "Hayalet Yerle\u015Fim"
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300688
    m_Localized: "Tepsindeki par\xE7alardan birini se\xE7ip, o par\xE7a i\xE7in tahtadaki en uygun yeri saydam bir hayalet siluetiyle g\xF6sterir; par\xE7ay\u0131 oraya s\xFCr\xFCklemen yeterli."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300689
    m_Localized: "Coin Ya\u011Fmuru"
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300690
    m_Localized: "Tahtan\u0131n rastgele h\xFCcrelerine coin simgeleri yerle\u015Ftirir. Bu h\xFCcreleri sat\u0131r veya s\xFCtun temizleyerek yok etti\u011Finde coin kazan\u0131rs\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300691
    m_Localized: "Patlay\u0131c\u0131 \xC7ekirdek"
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300692
    m_Localized: "Bu h\xFCcre bir sat\u0131r veya s\xFCtun temizlenerek yok edildi\u011Finde, hemen etraf\u0131ndaki h\xFCcreleri de patlatarak zincirleme bir temizlik ba\u015Flat\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300693
    m_Localized: Lazer
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300694
    m_Localized: "Bu h\xFCcre yok edildi\u011Fi anda, bulundu\u011Fu sat\u0131r\u0131n ve s\xFCtunun tamam\u0131n\u0131 u\xE7tan uca temizler \u2014 dolu olsalar da olmasalar da."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300695
    m_Localized: Vortex
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300696
    m_Localized: "Etraf\u0131ndaki dolu h\xFCcreleri yava\u015F yava\u015F kendi merkezine do\u011Fru \xE7eker. Onu yok etmek i\xE7in \xFCzerine bir par\xE7a yerle\u015Ftirmen yeterli."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300697
    m_Localized: "Zincirleme \u015Eim\u015Fek"
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300698
    m_Localized: "Yok edildi\u011Finde, hemen yak\u0131n\u0131ndaki di\u011Fer \xF6zel h\xFCcrelere atlayarak onlar\u0131 da erkenden tetikler \u2014 bir \xF6zel h\xFCcre zinciri ba\u015Flatabilir."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300699
    m_Localized: "Puan M\xFCcevheri"
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300700
    m_Localized: "Bu h\xFCcre bir sat\u0131r veya s\xFCtun temizlenerek yok edildi\u011Finde, normal puan\u0131na ek olarak bonus puan kazand\u0131r\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300701
    m_Localized: "Coin H\xFCcresi"
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300702
    m_Localized: "Bu h\xFCcre bir sat\u0131r veya s\xFCtun temizlenerek yok edildi\u011Finde otomatik olarak bir coin kazan\u0131rs\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300703
    m_Localized: "Alt\u0131n Par\xE7a"
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300704
    m_Localized: "Art arda be\u015F hamlede sat\u0131r/s\xFCtun temizleyerek be\u015Fli bir kombo yakalad\u0131\u011F\u0131nda tepsine eklenir. Yerle\u015Ftirili\u015Fi tamamen s\u0131radan bir tekli blok gibidir \u2014 bu sadece ba\u015Far\u0131n\u0131 kutlayan g\xF6rsel bir \xF6d\xFCl."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300705
    m_Localized: Delici Roket
    m_Metadata:
      m_Items: []
  - m_Id: 1892479862300706
    m_Localized: "Tek bir par\xE7a yerle\u015Ftirmesiyle \xFC\xE7 veya daha fazla sat\u0131r/s\xFCtunu birden temizledi\u011Finde tepsine eklenir. Bu par\xE7ay\u0131 tahtaya yerle\u015Ftirdi\u011Finde, d\xFC\u015Ft\xFC\u011F\xFC h\xFCcrenin bulundu\u011Fu sat\u0131r\u0131 ve s\xFCtunu tamamen temizler."
    m_Metadata:
      m_Items: []
  - m_Id: 1892479866494976
    m_Localized: "Y\u0131k\u0131m \xC7eki"
    m_Metadata:
      m_Items: []
  - m_Id: 1892479866494977
    m_Localized: "Tahta neredeyse doldu\u011Funda ve hi\xE7bir par\xE7a yerle\u015Fmiyorsa son \xE7are olarak tepsine eklenir. S\xFCr\xFCklenmez \u2014 ikonuna dokunup silahland\u0131ktan sonra yok etmek istedi\u011Fin tek bir h\xFCcreye dokun."
    m_Metadata:
      m_Items: []
  - m_Id: 2010649772154880
    m_Localized: "\xC7oklu Sat\u0131r Temizleme"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515008
    m_Localized: "Par\xE7a Ailesi Say\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515009
    m_Localized: "Ko\u015Fuda Puan"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515010
    m_Localized: "Tahta Temizleme Say\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515011
    m_Localized: "Kombo E\u015Fi\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515012
    m_Localized: "Bomba ile Sat\u0131r Temizleme"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515013
    m_Localized: "\xC7apraz Temizlik"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515014
    m_Localized: "Son Anda Kurtar\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515015
    m_Localized: "Toplam Sat\u0131r Temizleme"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515016
    m_Localized: "Belirli Par\xE7a Say\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515017
    m_Localized: "Belirli Par\xE7a ile Temizlik"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515018
    m_Localized: "D\xF6rt K\xF6\u015Fe"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515019
    m_Localized: "Merkez \xC7ekirdek"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515020
    m_Localized: "Delik B\u0131rakmama Serisi"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515021
    m_Localized: Zaman Penceresinde Temizlik
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515022
    m_Localized: "Erken Puan Ata\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515023
    m_Localized: "Yeniden \xC7ekle Kurtar\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515024
    m_Localized: "G\xFC\xE7lendirilmi\u015F H\xFCcreler"
    m_Metadata:
      m_Items: []
  - m_Id: 2010649801515025
    m_Localized: "Renk Temizli\u011Fi"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
