  - m_Id: 149663784099840
    m_Localized: "Ayn\u0131 anda {0} s\u0131ra temizle"
    m_Metadata:
      m_Items: []
  - m_Id: 149663859597312
    m_Localized: "{0} par\xE7a yerle\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 149663863791616
    m_Localized: Tek turda puan topla
    m_Metadata:
      m_Items: []
  - m_Id: 149663863791617
    m_Localized: "T\xFCm tahtay\u0131 temizle"
    m_Metadata:
      m_Items: []
  - m_Id: 149663863791618
    m_Localized: tekli
    m_Metadata:
      m_Items: []
  - m_Id: 149663867985920
