  - m_Id: 4184519664984171
    m_Localized: "{0} \xB7 Seviye {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984172
    m_Localized: "Kilometre ta\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984173
    m_Localized: "GE\xC7 VE KAZAN"
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984174
    m_Localized: "K\u0130L\u0130TL\u0130 \xB7 GE\xC7 VE KAZAN"
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984175
    m_Localized: "\xD6D\xDCLLER \xB7 ALINDI"
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984176
    m_Localized: "\u0130lk deneme serisi \xB7 \u015Fu an {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984177
    m_Localized: "\u0130lk deneme serisi \xB7 bu ge\xE7i\u015Fle {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984178
    m_Localized: "\u0130lk deneme serisi \xB7 tekrarlar say\u0131lmaz"
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984179
    m_Localized: '{1}''TE +{0}'
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984180
    m_Localized: +{0} BONUS
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984181
    m_Localized: "G\xDC\xC7LER\u0130N"
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984183
    m_Localized: "A\xE7mak i\xE7in Seviye {0}'\u0131 ge\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984184
    m_Localized: "Ba\u015Fla"
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984185
    m_Localized: "Ba\u015Fla \xB7 {0} ek"
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984186
    m_Localized: Tekrar Oyna
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984187
    m_Localized: Reklam izle
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984188
    m_Localized: "Alt\u0131n h\xFCcre ek"
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984189
    m_Localized: '{0} hak birikti'
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984190
    m_Localized: "Alt\u0131n h\xFCcreler ekilemedi. Haklar\u0131n duruyor."
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984191
    m_Localized: "Bu seviye \u015Fu an ba\u015Flat\u0131lam\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984192
    m_Localized: KAZANDIN!
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984193
    m_Localized: "SER\u0130 BONUSU!"
    m_Metadata:
      m_Items: []
  - m_Id: 4184519664984194
    m_Localized: "SONRAK\u0130 \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4289495674380288
    m_Localized: '{0} / {1} can'
    m_Metadata:
      m_Items: []
  - m_Id: 4289495720517632
    m_Localized: "Kazanmak bedava. Bu b\xF6l\xFCm\xFC kaybetmek 1 cana mal olur."
    m_Metadata:
      m_Items: []
  - m_Id: 4289495720517633
    m_Localized: CANIN KALMADI
    m_Metadata:
      m_Items: []
  - m_Id: 4289495720517634
    m_Localized: CANLAR
    m_Metadata:
      m_Items: []
  - m_Id: 4289495720517635
    m_Localized: "SONRAK\u0130 +{0} CANA KALAN"
    m_Metadata:
      m_Items: []
  - m_Id: 4289495720517636
    m_Localized: "Her saat ba\u015F\u0131 {0} can yenilenir, en fazla {1} olur. Ya da hemen \u015Fimdi al:"
    m_Metadata:
      m_Items: []
  - m_Id: 4289495720517637
    m_Localized: Reklam izle
    m_Metadata:
      m_Items: []
  - m_Id: 4289495720517638
    m_Localized: Canlar dolu
    m_Metadata:
      m_Items: []
  - m_Id: 4289495720517639
    m_Localized: "\u015Eu an reklam yok. Birazdan tekrar dene."
    m_Metadata:
      m_Items: []
  - m_Id: 4289495720517640
    m_Localized: "\u015E\xF6len ve Klasik modlar can kullanmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 4289495720517641
    m_Localized: Bir can kaybettin
    m_Metadata:
      m_Items: []
  - m_Id: 4289495720517642
    m_Localized: "{0} \u2192 {1} can"
    m_Metadata:
      m_Items: []
  - m_Id: 4289495720517643
    m_Localized: "{1} i\xE7inde +{0}"
