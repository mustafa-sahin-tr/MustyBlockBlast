  - m_Id: 766500864
    m_Localized: REKOR ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 766500865
    m_Localized: HAMLE KALMADI
    m_Metadata:
      m_Items: []
  - m_Id: 766500866
    m_Localized: "S\xDCRE DOLDU"
    m_Metadata:
      m_Items: []
  - m_Id: 766500871
    m_Localized: "\u015E\xF6len Modu"
    m_Metadata:
      m_Items: []
